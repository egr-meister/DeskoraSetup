<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base application theme is intentionally minimal: Compose supplies the real
      Material 3 theme. This theme only backs the manifest and the splash screen.
    -->
    <style name="Theme.DeskoraSetup" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/blueprint_navy</item>
        <item name="android:navigationBarColor">@color/app_background</item>
    </style>

    <!-- Static splash screen using the AndroidX SplashScreen library. -->
    <style name="Theme.DeskoraSetup.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_desk</item>
        <item name="postSplashScreenTheme">@style/Theme.DeskoraSetup</item>
    </style>
</resources>
